@import url("https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;500;600&family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&family=Roboto+Slab:wght@300;400;500;600;700&display=swap");

html,
body,
#root {
  min-height: 100%;
  background: #070707;
}

html[data-theme='light'],
html[data-theme='light'] body,
html[data-theme='light'] #root {
  background: var(--bg);
}

body {
  margin: 0;
  overscroll-behavior: none;
}

* {
  box-sizing: border-box;
}

.blog-page {
  min-height: 100dvh;
  width: 100%;
  display: grid;
  grid-template-columns: 230px minmax(0, 920px);
  justify-content: center;
  gap: 3.5rem;
  padding: 4rem 2rem;
  color: #b8b8b8;
  overflow-x: hidden;
  background:
    radial-gradient(circle at top left, rgba(0, 177, 201, 0.11), transparent 34rem),
    radial-gradient(circle at bottom right, rgba(255, 255, 255, 0.035), transparent 28rem),
    #070707;
}

html[data-theme='light'] .blog-page {
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(0, 124, 137, 0.08), transparent 30rem),
    radial-gradient(circle at bottom right, rgba(31, 35, 40, 0.04), transparent 26rem),
    var(--bg);
}

html[data-theme='light'] .blog-sidebar {
  border: 1px solid var(--border);
  background: linear-gradient(180deg, var(--surface), var(--surface-soft));
  box-shadow: 0 18px 55px rgba(31, 35, 40, 0.08);
}

html[data-theme='light'] .blog-sidebar__eyebrow,
html[data-theme='light'] .blog-hero__eyebrow,
html[data-theme='light'] .blog-section-label {
  color: var(--accent);
}

html[data-theme='light'] .blog-sidebar__title,
html[data-theme='light'] .blog-sidebar__panel h3,
html[data-theme='light'] .blog-hero h1,
html[data-theme='light'] .blog-card h2,
html[data-theme='light'] .blog-article__header h1,
html[data-theme='light'] .blog-article__content h2,
html[data-theme='light'] .blog-post-header h1,
html[data-theme='light'] .blog-markdown h1,
html[data-theme='light'] .blog-markdown h2,
html[data-theme='light'] .blog-markdown h3,
html[data-theme='light'] .blog-markdown h4,
html[data-theme='light'] .blog-empty-state h2 {
  color: var(--text);
}

html[data-theme='light'] .blog-sidebar__panel p,
html[data-theme='light'] .blog-hero p,
html[data-theme='light'] .blog-card p,
html[data-theme='light'] .blog-article__content,
html[data-theme='light'] .blog-article__header p:last-child,
html[data-theme='light'] .blog-post-header__subtitle,
html[data-theme='light'] .blog-markdown,
html[data-theme='light'] .blog-empty-state p,
html[data-theme='light'] .blog-markdown blockquote,
html[data-theme='light'] .blog-markdown figcaption {
  color: var(--text-muted);
}

html[data-theme='light'] .blog-sidebar__panel a,
html[data-theme='light'] .blog-back,
html[data-theme='light'] .blog-card__meta,
html[data-theme='light'] .blog-card__date,
html[data-theme='light'] .blog-article__meta,
html[data-theme='light'] .blog-section-label,
html[data-theme='light'] .blog-sidebar__eyebrow,
html[data-theme='light'] .blog-post-header__meta,
html[data-theme='light'] .blog-post-header__updated,
html[data-theme='light'] .blog-post-footer a,
html[data-theme='light'] .blog-markdown a,
html[data-theme='light'] .blog-card__readtime {
  color: var(--accent);
}

html[data-theme='light'] .blog-mini-button {
  border: 1px solid rgba(0, 124, 137, 0.18);
  background: var(--accent-soft);
  color: var(--text);
}

html[data-theme='light'] .blog-mini-button:hover,
html[data-theme='light'] .blog-mini-button[aria-expanded='true'] {
  border-color: rgba(0, 124, 137, 0.35);
  background: rgba(0, 124, 137, 0.12);
}

html[data-theme='light'] .blog-sidebar__panel,
html[data-theme='light'] .blog-hero,
html[data-theme='light'] .blog-article__header,
html[data-theme='light'] .blog-post-header {
  border-color: var(--border);
}

html[data-theme='light'] .blog-card,
html[data-theme='light'] .blog-empty-state {
  border: 1px solid var(--border);
  background: linear-gradient(180deg, var(--surface), var(--surface-soft));
  box-shadow: 0 14px 42px rgba(31, 35, 40, 0.06);
}

html[data-theme='light'] .blog-card:hover {
  border-color: rgba(0, 124, 137, 0.3);
  background: linear-gradient(180deg, rgba(0, 124, 137, 0.07), var(--surface));
}

html[data-theme='light'] .blog-card__category,
html[data-theme='light'] .blog-post-header__tags span,
html[data-theme='light'] .blog-post-footer__tags span {
  border-color: rgba(0, 124, 137, 0.18);
  background: var(--accent-soft);
  color: var(--accent);
}

html[data-theme='light'] .blog-markdown blockquote {
  border-left-color: rgba(0, 124, 137, 0.35);
  background: var(--surface-soft);
}

html[data-theme='light'] .blog-markdown :not(pre) > code {
  background: rgba(0, 124, 137, 0.08);
  color: var(--text);
}

html[data-theme='light'] .blog-markdown__pre,
html[data-theme='light'] .blog-code-block,
html[data-theme='light'] .blog-code-block__header,
html[data-theme='light'] .blog-code-block__copy {
  background: var(--surface);
  border-color: var(--border);
}

html[data-theme='light'] .blog-markdown__pre,
html[data-theme='light'] .blog-code-block {
  box-shadow: 0 18px 45px rgba(31, 35, 40, 0.08);
}

html[data-theme='light'] .blog-markdown th,
html[data-theme='light'] .blog-markdown td,
html[data-theme='light'] .blog-markdown__figure img {
  border-color: var(--border);
}

html[data-theme='light'] .blog-markdown th {
  background: var(--surface-soft);
  color: var(--text);
}

html[data-theme='light'] .blog-code-block__language,
html[data-theme='light'] .blog-code-block__copy,
html[data-theme='light'] .blog-markdown__figure figcaption,
html[data-theme='light'] .blog-post-header__updated,
html[data-theme='light'] .blog-card__readtime,
html[data-theme='light'] .blog-card__date {
  color: var(--text-muted);
}

html[data-theme='light'] .blog-code-block__copy:hover {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: rgba(0, 124, 137, 0.35);
}

html[data-theme='light'] .blog-post-footer {
  border-top-color: var(--border);
}

html[data-theme='light'] .blog-post-header {
  border-bottom-color: var(--border);
}

html[data-theme='light'] .blog-card:hover h2 {
  color: var(--text);
}

html[data-theme='light'] .blog-markdown h1,
html[data-theme='light'] .blog-markdown h2,
html[data-theme='light'] .blog-markdown h3,
html[data-theme='light'] .blog-markdown h4 {
  color: var(--text);
}

html[data-theme='light'] .blog-markdown a:hover,
html[data-theme='light'] .blog-post-footer a:hover,
html[data-theme='light'] .blog-sidebar__panel a:hover,
html[data-theme='light'] .blog-back:hover {
  text-decoration: underline;
}

.blog-sidebar {
  position: sticky;
  top: 3rem;
  height: fit-content;
  padding: 1.1rem;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.075);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.02));
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(18px);
}

.blog-sidebar__eyebrow,
.blog-hero__eyebrow,
.blog-section-label {
  margin: 0;
  font-family: "Inconsolata", monospace;
  color: #78cbd4;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.76rem;
}

.blog-sidebar__title {
  margin: 0.65rem 0 1rem;
  font-family: "Roboto", sans-serif;
  font-size: 1rem;
  line-height: 1.35;
  color: #d8d8d8;
}

.blog-mini-actions {
  display: grid;
  gap: 0.65rem;
}

.blog-mini-button {
  width: 100%;
  border: 1px solid rgba(120, 203, 212, 0.32);
  border-radius: 999px;
  padding: 0.7rem 0.85rem;
  background: rgba(120, 203, 212, 0.075);
  color: #cfcfcf;
  font-family: "Inconsolata", monospace;
  font-size: 0.9rem;
  cursor: pointer;
  transition: 180ms ease;
}

.blog-mini-button:hover,
.blog-mini-button[aria-expanded="true"] {
  border-color: rgba(120, 203, 212, 0.7);
  background: rgba(120, 203, 212, 0.14);
  transform: translateY(-1px);
}

.blog-sidebar__panel {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255, 255, 255, 0.075);
}

.blog-sidebar__panel h3 {
  margin: 0 0 0.55rem;
  font-family: "Roboto", sans-serif;
  font-size: 0.95rem;
  color: #dcdcdc;
}

.blog-sidebar__panel p {
  margin: 0;
  font-family: "Open Sans", sans-serif;
  font-size: 0.88rem;
  line-height: 1.65;
  color: #9d9d9d;
}

.blog-sidebar__panel a {
  display: block;
  margin: 0.45rem 0;
  color: #78cbd4;
  text-decoration: none;
  font-family: "Inconsolata", monospace;
}

.blog-sidebar__panel a:hover {
  text-decoration: underline;
}

.blog-main,
.blog-article {
  min-width: 0;
}

.blog-back {
  display: inline-flex;
  align-items: center;
  margin-bottom: 2.25rem;
  color: #78cbd4;
  text-decoration: none;
  font-family: "Inconsolata", monospace;
  font-size: 0.95rem;
}

.blog-back:hover {
  text-decoration: underline;
}

.blog-hero {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.075);
}

.blog-hero h1 {
  max-width: 760px;
  margin: 0.65rem 0 1rem;
  font-family: "Roboto", sans-serif;
  font-size: clamp(2.35rem, 6vw, 4.4rem);
  line-height: 1.02;
  letter-spacing: -0.055em;
  color: #dddddd;
}

.blog-hero p {
  max-width: 680px;
  margin: 0;
  font-family: "Roboto Slab", serif;
  font-size: 1.08rem;
  line-height: 1.85;
  color: #a8a8a8;
}

.blog-featured {
  margin-bottom: 3rem;
}

.blog-list {
  display: grid;
  gap: 1rem;
}

.blog-card {
  display: block;
  padding: 1.45rem;
  border-radius: 18px;
  text-decoration: none;
  color: inherit;
  border: 1px solid rgba(255, 255, 255, 0.075);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.043), rgba(255, 255, 255, 0.018));
  box-shadow: 0 14px 42px rgba(0, 0, 0, 0.22);
  transition: 180ms ease;
}

.blog-card:hover {
  transform: translateY(-4px);
  border-color: rgba(120, 203, 212, 0.5);
  background: linear-gradient(180deg, rgba(120, 203, 212, 0.075), rgba(255, 255, 255, 0.025));
}

.blog-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem 0.85rem;
  color: #78cbd4;
  font-family: "Inconsolata", monospace;
  font-size: 0.86rem;
}

.blog-card h2 {
  margin: 0.75rem 0;
  font-family: "Roboto", sans-serif;
  color: #dcdcdc;
  font-size: 1.45rem;
  line-height: 1.28;
  letter-spacing: -0.02em;
}

.blog-card p {
  margin: 0;
  font-family: "Roboto Slab", serif;
  color: #a8a8a8;
  line-height: 1.75;
}

.blog-card__date {
  display: inline-block;
  margin-top: 0.9rem;
  color: #858585;
  font-family: "Inconsolata", monospace;
}

.blog-article {
  max-width: 820px;
}

.blog-article__header {
  text-align: center;
  padding-bottom: 3rem;
  margin-bottom: 3rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
}

.blog-article__meta {
  color: #78cbd4;
  font-family: "Inconsolata", monospace;
}

.blog-article__header h1 {
  margin: 0.75rem 0 1rem;
  font-family: "Roboto", sans-serif;
  color: #dddddd;
  font-size: clamp(2.2rem, 5vw, 3.7rem);
  line-height: 1.1;
  letter-spacing: -0.045em;
}

.blog-article__header p:last-child {
  max-width: 700px;
  margin: 0 auto;
  font-family: "Roboto Slab", serif;
  color: #a8a8a8;
  font-size: 1.08rem;
  line-height: 1.85;
}

.blog-article__content {
  font-family: "Roboto Slab", serif;
  font-size: 1.08rem;
  line-height: 1.92;
  color: #b4b4b4;
}

.blog-article__content h2 {
  margin-top: 3.2rem;
  margin-bottom: 0.75rem;
  font-family: "Roboto", sans-serif;
  font-size: 1.65rem;
  line-height: 1.25;
  color: #d8d8d8;
  letter-spacing: -0.02em;
}

.blog-article__content p {
  margin-bottom: 2rem;
}

.blog-card h2,
.blog-hero h1,
.blog-article__header h1,
.blog-article__content h2,
.blog-card p,
.blog-article__content p {
  overflow-wrap: anywhere;
}

@media (max-width: 1100px) {
  .blog-page {
    grid-template-columns: 220px minmax(0, 1fr);
    justify-content: stretch;
    gap: 2rem;
    padding: 3rem 1.5rem;
  }
}

@media (max-width: 900px) {
  .blog-page {
    grid-template-columns: 1fr;
    padding: 1.5rem;
  }

  .blog-sidebar {
    position: static;
  }

  .blog-mini-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .blog-hero h1 {
    font-size: clamp(2rem, 9vw, 3.2rem);
  }

  .blog-main,
  .blog-article {
    max-width: 100%;
  }
}

@media (max-width: 640px) {
  .blog-page {
    padding: 1rem;
    gap: 1.5rem;
  }

  .blog-sidebar {
    border-radius: 16px;
  }

  .blog-mini-actions {
    grid-template-columns: 1fr;
  }

  .blog-hero {
    margin-bottom: 2rem;
  }

  .blog-hero h1 {
    font-size: clamp(1.9rem, 11vw, 2.65rem);
  }

  .blog-hero p,
  .blog-card p,
  .blog-article__content {
    font-size: 1rem;
    line-height: 1.8;
  }

  .blog-card {
    padding: 1.1rem;
    border-radius: 15px;
  }

  .blog-card h2 {
    font-size: 1.2rem;
  }

  .blog-article__header {
    text-align: left;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .blog-article__header h1 {
    font-size: clamp(1.9rem, 11vw, 2.55rem);
  }

  .blog-article__header p:last-child {
    margin: 0;
  }

  .blog-article__content h2 {
    font-size: 1.35rem;
    margin-top: 2.2rem;
  }
}

@media (max-width: 420px) {
  .blog-page {
    padding: 0.75rem;
  }

  .blog-sidebar,
  .blog-card {
    border-radius: 13px;
  }

  .blog-section-label,
  .blog-sidebar__eyebrow,
  .blog-hero__eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }
}

/* Professional editorial blog cards */
.blog-list {
  gap: 0;
}

.blog-card {
  position: relative;
  display: block;
  padding: 1.6rem 0;
  border-radius: 0;
  border: 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: transparent;
  box-shadow: none;
  color: inherit;
  text-decoration: none;
  transition: border-color 180ms ease;
}

.blog-card:hover {
  transform: none;
  background: transparent;
  border-color: rgba(120, 203, 212, 0.38);
}

.blog-card--featured {
  padding: 1.6rem;
  margin-top: 0.8rem;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.025);
}

.blog-card--featured:hover {
  background: rgba(120, 203, 212, 0.035);
  border-color: rgba(120, 203, 212, 0.35);
}

.blog-card__top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-bottom: 0.75rem;
}

.blog-card__category {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  border: 1px solid rgba(120, 203, 212, 0.28);
  background: rgba(120, 203, 212, 0.06);
  color: #8fd6dd;
  font-family: "Inconsolata", monospace;
  font-size: 0.78rem;
}

.blog-card__readtime {
  color: #7f7f7f;
  font-family: "Inconsolata", monospace;
  font-size: 0.82rem;
}

.blog-card h2 {
  max-width: 760px;
  margin: 0 0 0.65rem;
  color: #d2d2d2;
  font-size: clamp(1.25rem, 2vw, 1.65rem);
  line-height: 1.25;
  letter-spacing: -0.025em;
}

.blog-card:hover h2 {
  color: #e0e0e0;
}

.blog-card p {
  max-width: 760px;
  margin: 0;
  color: #9f9f9f;
  font-size: 1rem;
  line-height: 1.75;
}

.blog-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 1rem;
  color: #7f7f7f;
  font-family: "Inconsolata", monospace;
  font-size: 0.86rem;
}

.blog-card__read {
  color: #8fd6dd;
  opacity: 0;
  transform: translateX(-4px);
  transition: 180ms ease;
}

.blog-card:hover .blog-card__read {
  opacity: 1;
  transform: translateX(0);
}

@media (max-width: 640px) {
  .blog-card {
    padding: 1.25rem 0;
  }

  .blog-card--featured {
    padding: 1.15rem;
    border-radius: 15px;
  }

  .blog-card__footer {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.45rem;
  }

  .blog-card__read {
    opacity: 1;
    transform: none;
  }
}

/* More compact mobile blog intro card */
@media (max-width: 640px) {
  .blog-sidebar {
    padding: 0.85rem;
    border-radius: 14px;
  }

  .blog-sidebar__eyebrow {
    font-size: 0.64rem;
    letter-spacing: 0.18em;
  }

  .blog-sidebar__title {
    font-size: 0.9rem;
    margin: 0.45rem 0 0.7rem;
  }

  .blog-mini-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .blog-mini-button {
    padding: 0.5rem 0.55rem;
    font-size: 0.78rem;
  }

  .blog-sidebar__panel {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
  }
}

@media (max-width: 380px) {
  .blog-mini-actions {
    grid-template-columns: 1fr;
  }
}

/* Empty blog state */
.blog-empty-state {
  margin-top: 1rem;
  padding: 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.075);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.025);
}

.blog-empty-state h2 {
  margin: 0 0 0.65rem;
  font-family: "Roboto", sans-serif;
  color: #d2d2d2;
  font-size: 1.35rem;
}

.blog-empty-state p {
  margin: 0;
  max-width: 620px;
  font-family: "Roboto Slab", serif;
  color: #9f9f9f;
  line-height: 1.75;
}

/* Part 3: Professional article renderer */
.blog-page--article {
  grid-template-columns: 220px minmax(0, 820px);
}

.blog-article-shell {
  min-width: 0;
  max-width: 820px;
}

.blog-post-header {
  text-align: center;
  padding: 1rem 0 3rem;
  margin-bottom: 3rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.085);
}

.blog-post-header__meta {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.55rem 0.9rem;
  margin-bottom: 1rem;
  color: #82cbd3;
  font-family: "Inconsolata", monospace;
  font-size: 0.9rem;
}

.blog-post-header h1 {
  max-width: 760px;
  margin: 0 auto 1rem;
  color: #d7d7d7;
  font-family: "Roboto", sans-serif;
  font-size: clamp(2.35rem, 5.5vw, 4rem);
  line-height: 1.05;
  letter-spacing: -0.055em;
}

.blog-post-header__subtitle {
  max-width: 680px;
  margin: 0 auto;
  color: #a6a6a6;
  font-family: "Roboto Slab", serif;
  font-size: 1.08rem;
  line-height: 1.85;
}

.blog-post-header__tags,
.blog-post-footer__tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 1.4rem;
}

.blog-post-header__tags span,
.blog-post-footer__tags span {
  padding: 0.3rem 0.65rem;
  border: 1px solid rgba(130, 203, 211, 0.25);
  border-radius: 999px;
  background: rgba(130, 203, 211, 0.055);
  color: #9fd9df;
  font-family: "Inconsolata", monospace;
  font-size: 0.8rem;
}

.blog-post-header__updated {
  margin: 1rem 0 0;
  color: #777;
  font-family: "Inconsolata", monospace;
  font-size: 0.82rem;
}

.blog-markdown {
  color: #b0b0b0;
  font-family: "Roboto Slab", serif;
  font-size: 1.08rem;
  line-height: 1.92;
}

.blog-markdown > *:first-child {
  margin-top: 0;
}

.blog-markdown h1,
.blog-markdown h2,
.blog-markdown h3,
.blog-markdown h4 {
  color: #d4d4d4;
  font-family: "Roboto", sans-serif;
  letter-spacing: -0.025em;
}

.blog-markdown h1 {
  font-size: 2.1rem;
  margin: 0 0 1.4rem;
}

.blog-markdown h2 {
  font-size: 1.65rem;
  margin: 3.2rem 0 0.75rem;
}

.blog-markdown h3 {
  font-size: 1.25rem;
  margin: 2.2rem 0 0.65rem;
}

.blog-markdown p,
.blog-markdown ul,
.blog-markdown ol,
.blog-markdown blockquote,
.blog-markdown pre,
.blog-markdown table,
.blog-markdown .blog-markdown__figure {
  margin-bottom: 2rem;
}

.blog-markdown ul,
.blog-markdown ol {
  padding-left: 1.5rem;
}

.blog-markdown li {
  margin-bottom: 0.55rem;
}

.blog-markdown a {
  color: #8fd6dd;
  text-decoration: none;
  border-bottom: 1px solid rgba(143, 214, 221, 0.35);
}

.blog-markdown a:hover {
  border-color: rgba(143, 214, 221, 0.85);
}

.blog-markdown blockquote {
  margin-left: 0;
  padding: 1rem 1.25rem;
  border-left: 3px solid rgba(143, 214, 221, 0.65);
  border-radius: 0 12px 12px 0;
  background: rgba(255, 255, 255, 0.035);
  color: #a9a9a9;
}

.blog-markdown code {
  font-family: "Inconsolata", monospace;
  font-size: 0.95em;
}

.blog-markdown :not(pre) > code {
  padding: 0.15rem 0.35rem;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.075);
  color: #d6d6d6;
}

.blog-markdown__pre {
  overflow-x: auto;
  padding: 1rem;
  border-radius: 14px;
  background: #111;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.blog-markdown__pre code {
  background: transparent;
}

.blog-markdown__figure {
  margin-left: 0;
  margin-right: 0;
}

.blog-markdown__figure img {
  width: 100%;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.blog-markdown__figure figcaption {
  margin-top: 0.65rem;
  color: #7d7d7d;
  font-family: "Inconsolata", monospace;
  font-size: 0.85rem;
  text-align: center;
}

.blog-markdown__table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.blog-markdown table {
  width: 100%;
  border-collapse: collapse;
  font-family: "Open Sans", sans-serif;
  font-size: 0.95rem;
}

.blog-markdown th,
.blog-markdown td {
  padding: 0.8rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.blog-markdown th {
  color: #d8d8d8;
  background: rgba(255, 255, 255, 0.045);
}

.blog-post-footer {
  margin-top: 4rem;
  padding-top: 2rem;
  text-align: center;
  border-top: 1px solid rgba(255, 255, 255, 0.085);
}

.blog-post-footer a {
  display: inline-flex;
  margin-top: 1.2rem;
  color: #8fd6dd;
  text-decoration: none;
  font-family: "Inconsolata", monospace;
}

.blog-post-footer a:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .blog-page--article {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .blog-post-header {
    text-align: left;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .blog-post-header__meta,
  .blog-post-header__tags,
  .blog-post-footer__tags {
    justify-content: flex-start;
  }

  .blog-post-header h1 {
    font-size: clamp(2rem, 11vw, 2.8rem);
  }

  .blog-post-header__subtitle,
  .blog-markdown {
    font-size: 1rem;
    line-height: 1.82;
  }

  .blog-markdown h1 {
    font-size: 1.75rem;
  }

  .blog-markdown h2 {
    font-size: 1.35rem;
    margin-top: 2.4rem;
  }

  .blog-markdown__pre {
    padding: 0.85rem;
  }

  .blog-post-footer {
    text-align: left;
  }
}

/* Part 4: VS Code-style code blocks */
.blog-code-block {
  margin: 2rem 0;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.095);
  border-radius: 16px;
  background: #1e1e1e;
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.35);
}

.blog-code-block__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 42px;
  padding: 0.65rem 0.9rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  background: #252526;
}

.blog-code-block__language {
  color: #a6a6a6;
  font-family: "Inconsolata", monospace;
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.blog-code-block__copy {
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 8px;
  padding: 0.35rem 0.65rem;
  background: #2d2d2d;
  color: #d0d0d0;
  font-family: "Inconsolata", monospace;
  font-size: 0.82rem;
  cursor: pointer;
  transition: 160ms ease;
}

.blog-code-block__copy:hover {
  border-color: rgba(143, 214, 221, 0.55);
  background: #343434;
  color: #ffffff;
}

.blog-code-block > div {
  overflow-x: auto !important;
}

.blog-code-block code {
  font-family: "Cascadia Code", "Fira Code", "Inconsolata", Consolas, monospace !important;
}

.blog-markdown .blog-code-block {
  margin-bottom: 2rem;
}

@media (max-width: 640px) {
  .blog-code-block {
    border-radius: 13px;
  }

  .blog-code-block__header {
    min-height: 38px;
    padding: 0.55rem 0.75rem;
  }

  .blog-code-block__language,
  .blog-code-block__copy {
    font-size: 0.75rem;
  }
}


/* Professional light theme for blog only */
:where([data-theme="light"], .light, .light-theme) .blog-page {
  --blog-light-bg: #f6f4ef;
  --blog-light-surface: #fffdf8;
  --blog-light-surface-soft: #f0ede5;
  --blog-light-text: #1f2933;
  --blog-light-text-soft: #4b5563;
  --blog-light-muted: #6b7280;
  --blog-light-border: rgba(31, 41, 51, 0.12);
  --blog-light-accent: #006b75;
  --blog-light-accent-soft: rgba(0, 107, 117, 0.08);
  --blog-light-code-bg: #f3f4f6;

  background:
    radial-gradient(circle at top left, rgba(0, 107, 117, 0.08), transparent 32rem),
    linear-gradient(180deg, #f9f7f2 0%, var(--blog-light-bg) 100%);
  color: var(--blog-light-text);
}

:where([data-theme="light"], .light, .light-theme) .blog-sidebar,
:where([data-theme="light"], .light, .light-theme) .blog-card--featured,
:where([data-theme="light"], .light, .light-theme) .blog-empty-state {
  background: var(--blog-light-surface);
  border-color: var(--blog-light-border);
  box-shadow: 0 18px 45px rgba(31, 41, 51, 0.08);
}

:where([data-theme="light"], .light, .light-theme) .blog-card {
  border-color: var(--blog-light-border);
}

:where([data-theme="light"], .light, .light-theme) .blog-card:hover {
  border-color: rgba(0, 107, 117, 0.35);
  background: var(--blog-light-accent-soft);
}

:where([data-theme="light"], .light, .light-theme) .blog-hero,
:where([data-theme="light"], .light, .light-theme) .blog-post-header,
:where([data-theme="light"], .light, .light-theme) .blog-post-footer {
  border-color: var(--blog-light-border);
}

:where([data-theme="light"], .light, .light-theme) .blog-hero h1,
:where([data-theme="light"], .light, .light-theme) .blog-sidebar__title,
:where([data-theme="light"], .light, .light-theme) .blog-card h2,
:where([data-theme="light"], .light, .light-theme) .blog-post-header h1,
:where([data-theme="light"], .light, .light-theme) .blog-markdown h1,
:where([data-theme="light"], .light, .light-theme) .blog-markdown h2,
:where([data-theme="light"], .light, .light-theme) .blog-markdown h3,
:where([data-theme="light"], .light, .light-theme) .blog-empty-state h2 {
  color: var(--blog-light-text);
}

:where([data-theme="light"], .light, .light-theme) .blog-hero p,
:where([data-theme="light"], .light, .light-theme) .blog-card p,
:where([data-theme="light"], .light, .light-theme) .blog-markdown,
:where([data-theme="light"], .light, .light-theme) .blog-post-header__subtitle,
:where([data-theme="light"], .light, .light-theme) .blog-empty-state p,
:where([data-theme="light"], .light, .light-theme) .blog-sidebar__panel p {
  color: var(--blog-light-text-soft);
}

:where([data-theme="light"], .light, .light-theme) .blog-card__date,
:where([data-theme="light"], .light, .light-theme) .blog-card__readtime,
:where([data-theme="light"], .light, .light-theme) .blog-post-header__updated {
  color: var(--blog-light-muted);
}

:where([data-theme="light"], .light, .light-theme) .blog-back,
:where([data-theme="light"], .light, .light-theme) .blog-section-label,
:where([data-theme="light"], .light, .light-theme) .blog-hero__eyebrow,
:where([data-theme="light"], .light, .light-theme) .blog-sidebar__eyebrow,
:where([data-theme="light"], .light, .light-theme) .blog-card__category,
:where([data-theme="light"], .light, .light-theme) .blog-card__read,
:where([data-theme="light"], .light, .light-theme) .blog-post-header__meta,
:where([data-theme="light"], .light, .light-theme) .blog-post-footer a,
:where([data-theme="light"], .light, .light-theme) .blog-markdown a {
  color: var(--blog-light-accent);
}

:where([data-theme="light"], .light, .light-theme) .blog-card__category,
:where([data-theme="light"], .light, .light-theme) .blog-post-header__tags span,
:where([data-theme="light"], .light, .light-theme) .blog-post-footer__tags span {
  background: var(--blog-light-accent-soft);
  border-color: rgba(0, 107, 117, 0.22);
  color: var(--blog-light-accent);
}

:where([data-theme="light"], .light, .light-theme) .blog-mini-button {
  background: var(--blog-light-accent-soft);
  border-color: rgba(0, 107, 117, 0.24);
  color: var(--blog-light-accent);
}

:where([data-theme="light"], .light, .light-theme) .blog-mini-button:hover,
:where([data-theme="light"], .light, .light-theme) .blog-mini-button[aria-expanded="true"] {
  background: rgba(0, 107, 117, 0.14);
  border-color: rgba(0, 107, 117, 0.42);
}

:where([data-theme="light"], .light, .light-theme) .blog-markdown blockquote {
  background: var(--blog-light-surface-soft);
  border-left-color: var(--blog-light-accent);
  color: var(--blog-light-text-soft);
}

:where([data-theme="light"], .light, .light-theme) .blog-markdown :not(pre) > code {
  background: var(--blog-light-code-bg);
  color: #243447;
}
