{
  "name": "@manishrathaur/react-blog-kit",
  "version": "0.1.0",
  "description": "A production-ready React blog kit for developer portfolios with markdown, search, code blocks, TOC, theme support, and optional AI actions.",
  "type": "module",
  "license": "MIT",
  "author": "Manish Rathaur",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "fuse.js": "^7.1.0",
    "github-slugger": "^2.0.0",
    "prismjs": "^1.30.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0"
  },
  "keywords": [
    "react",
    "blog",
    "portfolio",
    "markdown",
    "developer-blog",
    "toc",
    "code-blocks",
    "ai"
  ]
}